# ─── LLM Backend (pick one) ───

# Option 1: Ollama Cloud (OpenAI-compatible API)
# Set OLLAMA_API_KEY to use cloud models. Get your key from ollama.com.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=deepseek-v4-pro:cloud

# Option 2: OpenRouter (OpenAI-compatible API)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Option 3: Local Ollama (default when no API key is set)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# ─── General ───
LLM_TIMEOUT=60

# ─── Rate limiting (per-IP) ───
RATE_LIMIT_DAY=200
RATE_LIMIT_HOUR=1000

# ─── Server ───
HOST=0.0.0.0
PORT=8000
